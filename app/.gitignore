node_modules/

# The build output is derived, but the directory itself must exist: the binary
# embeds it with `//go:embed all:app/dist`, and an embed matching nothing is a
# compile error on a fresh checkout. Hence the tracked .gitkeep.
#
# The first line re-includes the directory, which a global ignore of `dist/`
# would otherwise exclude outright — and git does not look inside an excluded
# directory, so without it the negation below could never match.
!dist/
dist/*
!dist/.gitkeep
*.tsbuildinfo
.vite/
.vite-dev.log
.tmp/

# facet's build cache for the report template, and what a local render writes.
# `.facet/` holds an .npmrc that can inherit registry auth tokens, so it must
# never be committed. `!dist/` above re-includes every dist directory in the
# tree, which is why the report's own output has to be excluded again here.
.facet/
reports/dist/

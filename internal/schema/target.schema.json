{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flanksource.com/schemas/recon/target.schema.json",
  "title": "Recon target",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "id", "class", "profiles", "tags"],
  "properties": {
    "$schema": { "const": "../target.schema.json", "readOnly": true },
    "version": { "const": 3, "readOnly": true },
    "id": {
      "description": "Stable inventory identity, independent of a provider resource ID or mutable address.",
      "type": "string",
      "anyOf": [
        { "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" },
        { "format": "ipv6" }
      ],
      "readOnly": true
    },
    "host": {
      "anyOf": [
        { "$ref": "#/$defs/hostname" },
        { "$ref": "#/$defs/ip" }
      ],
      "readOnly": true
    },
    "kind": {
      "description": "What this target addresses. A host is contacted over the network; a provider-context is an explicit provider-native scan scope. Absent means host.",
      "type": "string",
      "enum": ["host", "provider-context"],
      "default": "host",
      "readOnly": true
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "readOnly": true
    },
    "credentialMode": {
      "type": "string",
      "enum": ["ambient", "configured"]
    },
    "arguments": {
      "type": "object",
      "description": "Provider-native non-secret scope arguments, validated by the generated provider schema."
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envVars": {
          "type": "array",
          "items": { "$ref": "#/$defs/credentialEnvVar" }
        },
        "connections": {
          "type": "object",
          "description": "Execution connections validated by the selected provider credential schema."
        }
      }
    },
    "class": {
      "type": "string",
      "enum": ["public", "prod", "non-prod", "internal", "unclassified", "deactivated"]
    },
    "app": { "$ref": "#/$defs/nonEmptyString" },
    "cluster": { "$ref": "#/$defs/nonEmptyString" },
    "source": { "$ref": "#/$defs/nonEmptyString" },
    "profiles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^scan:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "ports": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
      "minItems": 1,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "notes": { "$ref": "#/$defs/nonEmptyString" },
    "reason": { "$ref": "#/$defs/nonEmptyString" },
    "observed": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "first_observed": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" },
        "last_attempt": { "type": "string", "format": "date-time" },
        "error": { "$ref": "#/$defs/nonEmptyString" },
        "failure": {
          "description": "Why the last probe failed, classified. Absent when the host answered.",
          "enum": ["dns", "refused", "unreachable", "timeout", "tls", "http", "other"]
        }
      }
    },
    "network": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "ip": { "$ref": "#/$defs/ip" },
        "ipv4": { "$ref": "#/$defs/ipv4List" },
        "ipv6": { "$ref": "#/$defs/ipv6List" },
        "cname": { "$ref": "#/$defs/stringList" },
        "resolvers": { "$ref": "#/$defs/stringList" },
        "open_ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "cdn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "type": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "asn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "number": { "type": "integer", "minimum": 0 },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "country": { "$ref": "#/$defs/nonEmptyString" },
            "range": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "http": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
        "title": { "type": "string" },
        "webserver": { "type": "string" },
        "content_type": { "type": "string" },
        "location": { "type": "string" },
        "response_time": { "type": "string" },
        "known_paths": { "$ref": "#/$defs/stringList" },
        "login_methods": { "$ref": "#/$defs/stringList" },
        "failed": { "type": "boolean" }
      }
    },
    "tech": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "names": { "$ref": "#/$defs/stringList" },
        "cpe": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cpe"],
            "properties": {
              "product": { "type": "string" },
              "vendor": { "type": "string" },
              "cpe": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "tls_version": { "type": "string" },
        "cipher": { "type": "string" },
        "subject_dn": { "type": "string" },
        "subject_cn": { "type": "string" },
        "subject_org": { "$ref": "#/$defs/stringList" },
        "subject_an": { "$ref": "#/$defs/stringList" },
        "issuer_dn": { "type": "string" },
        "issuer_cn": { "type": "string" },
        "issuer_org": { "$ref": "#/$defs/stringList" },
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" },
        "serial": { "type": "string" },
        "expired": { "type": "boolean" },
        "self_signed": { "type": "boolean" },
        "mismatched": { "type": "boolean" },
        "revoked": { "type": "boolean" },
        "untrusted": { "type": "boolean" },
        "wildcard_certificate": { "type": "boolean" },
        "fingerprint_hash": { "type": "string" }
      }
    },
    "scan": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "properties": {
        "last_scan": { "type": "string", "format": "date-time" },
        "last_findings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "class": { "const": "deactivated" } }, "required": ["class"] },
      "then": { "properties": { "reason": true }, "required": ["reason"] }
    },
    {
      "if": {
        "properties": { "class": { "not": { "const": "deactivated" } } },
        "required": ["class"]
      },
      "then": { "not": { "properties": { "reason": true }, "required": ["reason"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "provider-context" } }, "required": ["kind"] },
      "then": {
        "required": ["provider", "credentialMode"],
        "not": { "anyOf": [
          { "required": ["host"] },
          { "required": ["ports"] }
        ] }
      },
      "else": {
        "required": ["host"],
        "not": { "anyOf": [
          { "required": ["provider"] },
          { "required": ["credentialMode"] },
          { "required": ["arguments"] },
          { "required": ["credentials"] }
        ] }
      }
    }
  ],
  "$defs": {
    "credentialEnvVar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1, "writeOnly": true },
        "valueFrom": { "$ref": "#/$defs/credentialValueFrom" },
        "configured": { "type": "boolean", "const": true, "readOnly": true }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["valueFrom"] },
        { "required": ["configured"] }
      ]
    },
    "credentialValueFrom": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["secretKeyRef"] },
        { "required": ["configMapKeyRef"] },
        { "required": ["helmRef"] },
        { "required": ["onePassword"] }
      ],
      "properties": {
        "secretKeyRef": { "$ref": "#/$defs/keySelector" },
        "configMapKeyRef": { "$ref": "#/$defs/keySelector" },
        "helmRef": { "$ref": "#/$defs/keySelector" },
        "onePassword": { "type": "string", "pattern": "^op://[^/]+/[^/]+/.+$" }
      }
    },
    "keySelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "hostname": {
      "type": "string",
      "format": "hostname",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "ipv4List": {
      "type": "array",
      "items": { "type": "string", "format": "ipv4" },
      "uniqueItems": true
    },
    "ipv6List": {
      "type": "array",
      "items": { "type": "string", "format": "ipv6" },
      "uniqueItems": true
    },
    "ip": {
      "type": "string",
      "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }]
    }
  }
}

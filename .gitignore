# Scan output against live infrastructure — never commit. Anchored: an
# unanchored `results/` also swallows contract/snapshot/results/, whose findings
# are synthetic and redacted and MUST be committed.
/results/

# Rendered target lists and per-run engine scratch — derived, never edited.
/.gen/

# Engine binaries provisioned by deps. deps-lock.yaml IS committed, so the
# resolved versions and checksums stay reproducible.
/.bin/

# Local development against sibling checkouts; CI resolves the go.mod pins.
/go.work
/go.work.sum

# Embedded Postgres data directory — holds the live inventory.
/.data/

# The repository skill moved to .agents; keep any legacy Claude state local.
/.claude/

# Repository skills are project deliverables. A global ~/.config/git/ignore
# excludes all .agents/ dirs, so re-include skills without local agent state.
!.agents/
.agents/*
!.agents/skills/
.claude
